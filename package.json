{
  "name": "gafu-v2",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.3.2",
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "start": "bun run scripts/start.ts",
    "check": "biome check . && tsc --noEmit",
    "format": "biome format --write .",
    "test": "bun test",
    "build": "tsc --noEmit && vite build",
    "test:browser": "playwright test",
    "kaishi:install": "bun run scripts/install-kaishi-seed.ts",
    "migration:v1:fetch": "bun run scripts/fetch-v1-snapshot.ts",
    "migration:v1": "bun run scripts/migrate-v1.ts",
    "migration:v1:mark-known": "bun run scripts/mark-import-known.ts",
    "backup:inspect": "bun run scripts/recover-backup.ts inspect",
    "backup:restore": "bun run scripts/recover-backup.ts restore",
    "health": "bun run scripts/health.ts",
    "spike:provider": "bun run scripts/phase-0-provider-smoke.ts",
    "subs:scan": "bun run scripts/scan-subtitles.ts",
    "subs:context": "bun run scripts/subtitle-context.ts",
    "cards:add": "bun run scripts/add-cards.ts"
  },
  "dependencies": {
    "@faanau/kuromoji": "0.2.1",
    "lit-html": "latest",
    "ts-fsrs": "5.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@playwright/test": "latest",
    "@types/bun": "1.3.2",
    "typescript": "latest",
    "vite": "latest"
  }
}
